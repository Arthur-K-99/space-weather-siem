# Copy to .env and fill in. Never commit .env.

# Elasticsearch
ELASTIC_PASSWORD=changeme
ES_URL=http://elasticsearch:9200

# Kibana
KIBANA_URL=http://kibana:5601

# NASA DONKI — get a free key at https://api.nasa.gov (DEMO_KEY works, low rate limit)
NASA_API_KEY=DEMO_KEY

# Collector poll intervals (seconds)
POLL_INTERVAL_REALTIME=60
POLL_INTERVAL_DONKI=900

# Detector evaluation interval (seconds)
DETECTOR_INTERVAL=60
