# Copy to .env and fill in. Never commit .env.

# Elasticsearch
ELASTIC_PASSWORD=changeme
# Host-side URL (scripts/bootstrap.py etc.); containers get the in-network
# address from docker-compose.yml instead.
ES_URL=http://localhost:9200

# Kibana
# Password docker-compose sets for the built-in kibana_system user
KIBANA_PASSWORD=changeme-kibana
# Any string of 32+ chars; keeps Kibana saved objects decryptable across restarts
KIBANA_ENCRYPTION_KEY=change-me-to-any-32-plus-char-string
KIBANA_URL=http://localhost:5601

# NASA DONKI — get a free key at https://api.nasa.gov (DEMO_KEY works, low rate limit)
NASA_API_KEY=DEMO_KEY

# Collector poll intervals (seconds)
POLL_INTERVAL_REALTIME=60
POLL_INTERVAL_DONKI=900

# Detector evaluation interval (seconds)
DETECTOR_INTERVAL=60
